#!/bin/sh
# Select the validated Safe Graphics path or the MOKO desktop compositor.
set -eu

cmdline=$(cat /proc/cmdline 2>/dev/null || true)
case " $cmdline " in
  *" moko.mode=hardware-diagnostics "*) MOKO_BOOT_MODE=hardware-diagnostics ;;
  *" moko.mode=safe-graphics "*) MOKO_BOOT_MODE=safe-graphics ;;
  *) MOKO_BOOT_MODE=desktop ;;
esac
export MOKO_BOOT_MODE

if [ -d /run/live ]; then
  export MOKO_LIVE_LAUNCH_EVENTS="${XDG_RUNTIME_DIR:?}/moko-launch-events"
fi

boot_uptime_ms() {
  awk '{ printf "%d", $1 * 1000 }' "${MOKO_BOOT_UPTIME_FILE:-/proc/uptime}" 2>/dev/null \
    || printf '0'
}

report_boot_timing() {
  stage=$1
  [ -n "${MOKO_LIVE_LAUNCH_EVENTS:-}" ] || return 0
  mkdir -p "$(dirname "$MOKO_LIVE_LAUNCH_EVENTS")"
  printf 'MOKO_BOOT_TIMING stage=%s uptime_ms=%s uid=%s\n' \
    "$stage" "$(boot_uptime_ms)" "$(id -u)" \
    >>"$MOKO_LIVE_LAUNCH_EVENTS" 2>/dev/null || true
}

blank_consumer_vt() {
  [ "$MOKO_BOOT_MODE" != hardware-diagnostics ] || return 0
  consumer_tty=${MOKO_CONSUMER_TTY:-/dev/tty}
  [ -w "$consumer_tty" ] || return 0
  printf '\033[40m\033[2J\033[H\033[?25l' >>"$consumer_tty" 2>/dev/null || true
}

# Keep the consumer VT empty behind the compositor so teardown cannot reveal
# startup diagnostics. The explicit hardware-diagnostics profile stays verbose.
if [ "$MOKO_BOOT_MODE" != hardware-diagnostics ] \
    && [ "${MOKO_SESSION_OUTPUT_ROUTED:-0}" != 1 ]; then
  blank_consumer_vt
  export MOKO_SESSION_OUTPUT_ROUTED=1
  if command -v systemd-cat >/dev/null 2>&1 \
      && [ -S /run/systemd/journal/stdout ]; then
    exec systemd-cat --identifier=moko-session "$0" "$@"
  fi
  session_log="${XDG_RUNTIME_DIR:-/tmp}/moko-session.log"
  exec "$0" "$@" >"$session_log" 2>&1
fi

report_boot_timing session-start

requested_compositor=${MOKO_COMPOSITOR:-moko}
case "$requested_compositor" in
  moko|cage) ;;
  *) requested_compositor=moko ;;
esac

if [ "$MOKO_BOOT_MODE" = safe-graphics ] || [ "$requested_compositor" = cage ]; then
  export MOKO_COMPOSITOR=cage
  if [ "$MOKO_BOOT_MODE" = safe-graphics ]; then
    export MOKO_SAFE_GRAPHICS=1
    export WLR_RENDERER=pixman
    export WLR_NO_HARDWARE_CURSORS=1
    export LIBGL_ALWAYS_SOFTWARE=1
    export QT_QUICK_BACKEND=software
  fi
  report_boot_timing compositor-launch
  exec cage -s -- /usr/local/bin/moko-session
fi

export MOKO_COMPOSITOR=moko
wayland_display=${MOKO_WAYLAND_DISPLAY:-wayland-moko-0}
compositor_bin=${MOKO_COMPOSITOR_BIN:-/usr/local/bin/moko-compositor}
session_bin=${MOKO_SESSION_BIN:-/usr/local/bin/moko-session}
compositor_ready_file="${XDG_RUNTIME_DIR:?}/moko-compositor.ready"
if [ -n "${MOKO_LIVE_LAUNCH_EVENTS:-}" ]; then
  mkdir -p "$(dirname "$MOKO_LIVE_LAUNCH_EVENTS")"
fi
compositor_pid=
compositor_ready=0

cleanup() {
  if [ -n "$compositor_pid" ]; then
    kill "$compositor_pid" 2>/dev/null || true
    wait "$compositor_pid" 2>/dev/null || true
  fi
  # Redraw the backing VT after DRM teardown so the previous desktop buffer
  # cannot flash between compositor exit and Plymouth's poweroff takeover.
  blank_consumer_vt
}
trap cleanup EXIT INT TERM

# The server socket names this compositor. It must not be mistaken for an
# upstream display by wlroots backend auto-detection.
start_attempt=0
while [ "$start_attempt" -lt 3 ]; do
  start_attempt=$((start_attempt + 1))
  rm -f "${XDG_RUNTIME_DIR:?}/$wayland_display" "$compositor_ready_file"
  (
    unset WAYLAND_DISPLAY WAYLAND_SOCKET DISPLAY
    export MOKO_COMPOSITOR_READY_FILE="$compositor_ready_file"
    exec "$compositor_bin" --socket "$wayland_display"
  ) &
  compositor_pid=$!

  ready_attempt=0
  while :; do
    if ! kill -0 "$compositor_pid" 2>/dev/null; then
      wait "$compositor_pid" 2>/dev/null || true
      compositor_pid=
      break
    fi

    ready_pid=$(cat "$compositor_ready_file" 2>/dev/null || true)
    if [ "$ready_pid" = "$compositor_pid" ] \
        && [ -S "${XDG_RUNTIME_DIR:?}/$wayland_display" ]; then
      compositor_ready=1
      break
    fi

    ready_attempt=$((ready_attempt + 1))
    if [ "$ready_attempt" -ge 300 ]; then
      kill "$compositor_pid" 2>/dev/null || true
      wait "$compositor_pid" 2>/dev/null || true
      compositor_pid=
      break
    fi
    sleep 0.05
  done

  if [ "$compositor_ready" -eq 1 ]; then
    break
  fi
  rm -f "${XDG_RUNTIME_DIR:?}/$wayland_display" "$compositor_ready_file"
  sleep 1
done

[ "$compositor_ready" -eq 1 ] || exit 1
report_boot_timing compositor-ready

export WAYLAND_DISPLAY=$wayland_display
"$session_bin"
status=$?
exit "$status"
