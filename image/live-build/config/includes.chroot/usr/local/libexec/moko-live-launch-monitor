#!/bin/sh
# DEV_ONLY: reports sanitized shell launch events for preview validation.
set -eu

report() {
  message=$1
  serial_device=${MOKO_SERIAL_LOG_DEVICE:-/dev/ttyS0}

  printf '%s\n' "$message" 2>/dev/null || :
  if [ -c "$serial_device" ] && [ -w "$serial_device" ]; then
    (printf '%s\n' "$message" > "$serial_device") 2>/dev/null || :
  fi
  return 0
}

uid=$(id -u moko)
runtime_dir="/run/user/$uid"
events="$runtime_dir/moko-launch-events"

while [ ! -d "$runtime_dir" ]; do
  sleep 1
done

# Shutdown readiness is emitted immediately before the delay inhibitor is
# released, so avoid tail's one-second default polling delay during teardown.
tail -s 0.05 -n +1 -F "$events" 2>/dev/null | while IFS= read -r event; do
  case "$event" in
    MOKO_APP_LAUNCH\ *|MOKO_APP_READY\ *|MOKO_APP_ACTION\ *|MOKO_AI_*|MOKO_BOOT_*|MOKO_COMPOSITOR_*|MOKO_WINDOW_*|MOKO_CONTROL_*|MOKO_INPUT_*|MOKO_DESKTOP_*|MOKO_GLOBAL_ACTION\ *|MOKO_SHELL_OVERLAY\ *|MOKO_HW_*|MOKO_BROWSER_*|MOKO_FILES_*|MOKO_SETTINGS_ACTION\ *|MOKO_SHELL_SURFACE\ *|MOKO_NOTIFICATION_*|MOKO_SCREENSHOT\ *|MOKO_SLEEP\ *|MOKO_RESUME_*|MOKO_SHUTDOWN_*)
      report "$event"
      ;;
  esac
done
