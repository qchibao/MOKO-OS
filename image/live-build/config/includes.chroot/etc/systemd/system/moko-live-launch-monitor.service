[Unit]
# DEV_ONLY: removed when Developer Preview validation moves to a guest agent.
Description=MOKO Developer Preview application launch monitor
DefaultDependencies=no
Before=greetd.service shutdown.target
Wants=greetd.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/moko-live-launch-monitor
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
