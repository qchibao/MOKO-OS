[Unit]
# DEV_ONLY: removed when the Developer Preview boot diagnostics are replaced.
Description=MOKO Developer Preview live boot health check
After=greetd.service NetworkManager.service
Wants=greetd.service NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/moko-live-health-check
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
