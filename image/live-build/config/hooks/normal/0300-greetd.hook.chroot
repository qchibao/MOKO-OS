#!/bin/sh
set -eu
cat > /etc/greetd/config.toml <<'CFG'
[terminal]
vt = 1

[default_session]
command = "cage -s -- /usr/local/bin/moko-session"
user = "moko"
CFG
# BOOTSTRAP: reserve VT1 for greetd while keeping serial and other VTs available.
systemctl disable getty@tty1.service || true
systemctl mask getty@tty1.service || true
systemctl enable greetd.service || true
systemctl enable moko-live-health.service || true
systemctl enable moko-live-launch-monitor.service || true
systemctl set-default graphical.target || true
