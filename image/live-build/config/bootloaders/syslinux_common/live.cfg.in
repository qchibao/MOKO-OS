label live-@FLAVOUR@
	menu label ^Try MOKO OS
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ moko.mode=desktop

label live-@FLAVOUR@-diagnostics
	menu label ^Hardware Diagnostics
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ moko.mode=hardware-diagnostics plymouth.enable=0 systemd.show_status=true rd.systemd.show_status=true loglevel=4 vt.global_cursor_default=1 console=tty0

label live-@FLAVOUR@-safe-graphics
	menu label ^Safe Graphics Mode
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ moko.mode=safe-graphics
